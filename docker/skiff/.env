# Curio-PDP image (published as filecoin/curio-pdp on release).
SKIFF_IMAGE=filecoin/curio-pdp:dev

# Network build target for the skiff binary.
#   skiff (mainnet, default) | calibnet-skiff | 2k-skiff
SKIFF_MAKE_TARGET=skiff

# Yugabyte image.
YUGABYTE_IMAGE=yugabytedb/yugabyte:2024.1.0.0-b129

# Forest chain node (official GHCR image).
FOREST_IMAGE=ghcr.io/chainsafe/forest:v0.35.0
FOREST_CHAIN=mainnet

# Host paths for persistent storage.
YUGABYTE_DATA=./data/yugabyte
FOREST_DATA=./data/forest
FOREST_TOKEN_DATA=./data/forest-token
SKIFF_REPO_DATA=./data/skiff
SKIFF_STORAGE=./data

# Public PDP API hostname seeded into the base config layer on first start.
SKIFF_HTTP_DOMAIN=localhost

# Optional: override the bundled Forest with an external Lotus/Forest RPC.
# Leave empty to use the compose Forest service (token + /ip4/forest/tcp/2345/http).
# If Lotus runs on the Docker host instead:
# FULLNODE_API_INFO=/ip4/host.docker.internal/tcp/1234/http
FULLNODE_API_INFO=
